# ==============================================================
# LostLink Configuration Template
# Copy this file to .env and adjust for your local environment.
# ==============================================================

PORT=3000
# Public URL used in email links
PUBLIC_URL=http://localhost:3000

# Set a long random string. If empty, a random one is generated on each start
# (everyone gets signed out whenever the server restarts).
JWT_SECRET=lostlink_jwt_secret_change_in_production_12345

# Admin account created on first start
ADMIN_EMAIL=admin@chitkara.edu
ADMIN_PASSWORD=admin123
ADMIN_NAME=Campus Admin

# Insert a few demo reports when the database is empty (true/false)
SEED_DEMO_DATA=true

# Set true only when serving over HTTPS
COOKIE_SECURE=false

# MongoDB connection URI (e.g. mongodb://127.0.0.1:27017/lostlink or your MongoDB Atlas mongodb+srv://... URI)
MONGODB_URI=mongodb://127.0.0.1:27017/lostlink

# Matching thresholds (0-100)
MATCH_MIN_SCORE=50
MATCH_STRONG_SCORE=70

# Email Domain Restriction (true/false)
# - false: Allow any Google/Email sign in (e.g. personal @gmail.com for development)
# - true:  Enforce @chitkara.edu / @chitkara.edu.in domain restriction
RESTRICT_EMAIL_DOMAIN=false

# ==============================================================
# FIREBASE AUTHENTICATION CONFIGURATION
# Get these from: Firebase Console -> Project Settings -> General -> Your apps (Web app </>)
# ==============================================================
FIREBASE_API_KEY=your_firebase_web_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id

# ==============================================================
# FIREBASE ADMIN SDK (Optional / Recommended for Server Token Verification)
# Get from: Firebase Console -> Project Settings -> Service accounts -> Generate new private key
#
# Option 1: Save the downloaded JSON file in the project folder and set its relative path:
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
#
# Option 2: Or paste the credentials directly:
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Note: If no service account is provided, tokens are still securely verified using
# Google's public certificates as long as FIREBASE_PROJECT_ID is filled above!
# ==============================================================

# ==============================================================
# Email (Nodemailer). For Gmail, generate an App Password in Google Account -> Security -> 2-Step Verification -> App passwords.
# If SMTP_HOST is empty, emails are logged to the console instead.
# ==============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
MAIL_FROM=LostLink <your_email@gmail.com>
